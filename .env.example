# Hugging Face Access Token (with WRITE permissions to upload models)
# Get yours from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_write_token_here

# OpenRouter API Key (Optional, only needed if regenerating SFT data with generate_sft.py)
# Get yours from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
